{
  "version": 1,
  "sdk_version": "0.28.0",
  "path": "/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "fairplay-india",
      "version": "1.0.0",
      "title": "Fairplay India"
    },
    "tools": [
      {
        "name": "list_blog_posts",
        "title": "List blog posts",
        "description": "List published Fairplay India blog posts (title, category, date, summary and public URL). Optionally filter by category.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "category": {
              "description": "Filter by category, e.g. Guide or Support.",
              "type": "string",
              "minLength": 1
            },
            "limit": {
              "default": 20,
              "description": "Maximum number of posts to return.",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "search_blog_posts",
        "title": "Search blog posts",
        "description": "Full-text search across public Fairplay India blog post titles, categories and summaries. Returns matching posts with their public URLs.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 2,
              "description": "Search words, e.g. 'IPL betting id' or 'withdrawal'."
            },
            "limit": {
              "default": 10,
              "description": "Maximum number of results.",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          "required": [
            "query"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "get_blog_post",
        "title": "Get blog post",
        "description": "Fetch a single public Fairplay India blog post by slug, returning its metadata and the readable Markdown version of the page.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "slug": {
              "type": "string",
              "minLength": 1,
              "description": "Post slug, e.g. fairplay-id-security-tips-protect-your-id-login."
            }
          },
          "required": [
            "slug"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "get_site_page",
        "title": "Get site page as Markdown",
        "description": "Fetch any public Fairplay India page by path (e.g. /betting, /app, /fairplay-id) and return its readable Markdown content.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "description": "Site-relative path starting with '/', e.g. /betting."
            }
          },
          "required": [
            "path"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
